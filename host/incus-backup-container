#!/bin/bash
# incus-backup-container INSTANCE
#
# Back up one running Incus/LXD instance to the Kopia repository server.
# The static Kopia binary, the backup password and a generated run script are
# injected into the guest for the duration of the run and removed afterwards.
#
# Exit status: 0 = success, or skipped because the instance is not running or a
# backup is already running; 1 = failure. last_success is only advanced when
# every selected source was snapshotted.
set -euo pipefail
# shellcheck source=lib/common.sh
source /usr/lib/incus-backup/common.sh
ib_load_config
ib_detect_cli

INSTANCE="${1:?Usage: $0 <instance>}"
[[ "${INSTANCE}" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || ib_die "invalid instance name '${INSTANCE}'"

install -d -m 0755 "${LOCK_DIR}"
install -d -m 0750 "${STATE_DIR}" "${LOG_DIR}" "${LOG_DIR}/kopia"
install -d -m 0700 "${STATE_DIR}/${INSTANCE}"
LOG_FILE="${LOG_DIR}/${INSTANCE}.log"

exec 9>"${LOCK_DIR}/${INSTANCE}.lock"
flock -n 9 || { echo "${INSTANCE}: backup already running; skipping"; exit 0; }

log() { printf '%s %s: %s\n' "$(date -Is)" "${INSTANCE}" "$*" | tee -a "${LOG_FILE}"; }
record() {
    printf '%s\n' "$2" >"${STATE_DIR}/${INSTANCE}/$1.tmp"
    mv -f "${STATE_DIR}/${INSTANCE}/$1.tmp" "${STATE_DIR}/${INSTANCE}/$1"
}
guest() { "${CLI}" exec --force-noninteractive "${INSTANCE}" -- "$@"; }

INSTANCE_JSON="$(ib_instance_json "${INSTANCE}")"
STATUS="$(jq -r '.status // empty' <<<"${INSTANCE_JSON}")"
if [[ "${STATUS}" != Running ]]; then
    log "not running (status ${STATUS:-unknown}); skipping"
    exit 0
fi

IDENTITY="$(ib_identity "${INSTANCE_JSON}")" || { log "ERROR: user.backup.hostname is not set"; exit 1; }
CREDENTIAL_FILE="${CREDENTIAL_DIR}/${IDENTITY}"
[[ -r "${CREDENTIAL_FILE}" ]] || {
    log "ERROR: ${CREDENTIAL_FILE} is missing; run: incus-backup-provision ${INSTANCE}"
    exit 1
}

META_MB="$(ib_cfg "${INSTANCE_JSON}" user.backup.cache.metadata_mb "${DEFAULT_METADATA_CACHE_MB}")"
META_LIMIT_MB="$(ib_cfg "${INSTANCE_JSON}" user.backup.cache.metadata_limit_mb "${DEFAULT_METADATA_CACHE_LIMIT_MB}")"
CONTENT_MB="$(ib_cfg "${INSTANCE_JSON}" user.backup.cache.content_mb "${DEFAULT_CONTENT_CACHE_MB}")"
CONTENT_LIMIT_MB="$(ib_cfg "${INSTANCE_JSON}" user.backup.cache.content_limit_mb "${DEFAULT_CONTENT_CACHE_LIMIT_MB}")"
for v in META_MB META_LIMIT_MB CONTENT_MB CONTENT_LIMIT_MB; do
    [[ "${!v}" =~ ^[0-9]+$ ]] || { log "ERROR: cache size ${v}='${!v}' is not a number"; exit 1; }
done
RT="$(ib_cfg "${INSTANCE_JSON}" user.backup.runtime_dir "${REMOTE_RUNTIME_DIR}")"
[[ "${RT}" =~ ^/[A-Za-z0-9_./-]+$ && "${RT}" != / ]] || { log "ERROR: invalid runtime dir '${RT}'"; exit 1; }
[[ "${REMOTE_CACHE_DIR}" =~ ^/[A-Za-z0-9_./-]+$ ]] || { log "ERROR: invalid REMOTE_CACHE_DIR"; exit 1; }
PRE_CMD="$(ib_cfg "${INSTANCE_JSON}" user.backup.pre)"
POST_CMD="$(ib_cfg "${INSTANCE_JSON}" user.backup.post)"

mapfile -t SOURCES < <(ib_sources "${INSTANCE_JSON}" 2> >(while IFS= read -r l; do log "${l}"; done))
(( ${#SOURCES[@]} > 0 )) || { log "ERROR: no sources selected (user.backup.root=false and no custom volumes)"; exit 1; }

# Build the guest run script. Values are single-quoted for POSIX sh.
TMP="$(mktemp -d)"
q() { ib_shell_quote "$1"; }
{
    printf '#!/bin/sh\n# Generated by incus-backup-container on %s. Runs inside the guest as root.\n' "$(hostname -f 2>/dev/null || hostname)"
    printf 'set -u\nRT=%s\nCACHE=%s\n' "$(q "${RT}")" "$(q "${REMOTE_CACHE_DIR}")"
    cat <<'GUEST'
KOPIA="$RT/kopia"
CFG="$RT/repository.config"
LOGS="$CACHE/logs"
KOPIA_PASSWORD="$(cat "$RT/password")" || exit 1
export KOPIA_PASSWORD
mkdir -p "$LOGS" && chmod 0700 "$CACHE" || exit 1
GUEST
    printf '"$KOPIA" --config-file="$CFG" --log-dir="$LOGS" --no-persist-credentials repository connect server'
    printf ' --url=%s --server-cert-fingerprint=%s' "$(q "${KOPIA_SERVER_URL}")" "$(q "${KOPIA_SERVER_FINGERPRINT}")"
    printf ' --override-username=backup --override-hostname=%s' "$(q "${IDENTITY}")"
    printf ' --cache-directory="$CACHE" --metadata-cache-size-mb=%s --metadata-cache-size-limit-mb=%s' "${META_MB}" "${META_LIMIT_MB}"
    printf ' --content-cache-size-mb=%s --content-cache-size-limit-mb=%s --no-check-for-updates || exit 1\n' "${CONTENT_MB}" "${CONTENT_LIMIT_MB}"
    cat <<'GUEST'
rc=0
snap() {
    echo "snapshotting $1 policy=$2"
    if ! "$KOPIA" --config-file="$CFG" --log-dir="$LOGS" snapshot create "$1" \
            --fail-fast --force-disable-actions --tags="backup-policy:$2"; then
        echo "FAILED: snapshot of $1"
        rc=1
    fi
}
GUEST
    for row in "${SOURCES[@]}"; do
        IFS=$'\t' read -r _kind path class _dev <<<"${row}"
        [[ "${path}" =~ ^/[^[:space:]\']*$ ]] || { log "ERROR: unsupported path '${path}'"; exit 1; }
        [[ "${class}" =~ ^[A-Za-z0-9_-]+$ ]] || { log "ERROR: invalid policy class '${class}'"; exit 1; }
        printf 'snap %s %s\n' "$(q "${path}")" "$(q "${class}")"
    done
    printf 'exit $rc\n'
} >"${TMP}/run.sh"

finish() {
    local rc=$?
    trap - EXIT
    guest rm -rf "${RT}" >/dev/null 2>&1 || true
    rm -rf "${TMP}"
    if (( rc == 0 )); then record last_result ok; else record last_result failed; fi
    exit "${rc}"
}
trap finish EXIT

START_EPOCH="$(date +%s)"
record last_attempt "${START_EPOCH}"
record last_result running

log "injecting Kopia into ${RT}"
guest rm -rf "${RT}"
guest sh -c 'mkdir -p "$1" && chmod 0700 "$1"' sh "${RT}"
"${CLI}" file push --quiet --mode 0700 --uid 0 --gid 0 "${KOPIA_BIN}" "${INSTANCE}${RT}/kopia"
"${CLI}" file push --quiet --mode 0600 --uid 0 --gid 0 "${CREDENTIAL_FILE}" "${INSTANCE}${RT}/password"
"${CLI}" file push --quiet --mode 0700 --uid 0 --gid 0 "${TMP}/run.sh" "${INSTANCE}${RT}/run.sh"

if [[ -n "${PRE_CMD}" ]]; then
    log "running user.backup.pre"
    guest sh -c "${PRE_CMD}" 2>&1 | tee -a "${LOG_FILE}" || { log "ERROR: user.backup.pre failed"; exit 1; }
fi

log "connecting as backup@${IDENTITY}; ${#SOURCES[@]} source(s)"
RUN_RC=0
guest sh "${RT}/run.sh" 2>&1 | tee -a "${LOG_FILE}" || RUN_RC=$?

if [[ -n "${POST_CMD}" ]]; then
    log "running user.backup.post"
    guest sh -c "${POST_CMD}" 2>&1 | tee -a "${LOG_FILE}" || log "WARNING: user.backup.post failed"
fi

if (( RUN_RC != 0 )); then
    log "backup FAILED (rc=${RUN_RC})"
    exit 1
fi

record last_success "${START_EPOCH}"
record last_success_iso "$(date -Is -d "@${START_EPOCH}")"
log "backup complete"
